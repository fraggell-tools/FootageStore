# Debian (glibc) base so we can use an NVENC-capable ffmpeg for GPU proxy encodes.
FROM node:20-bookworm-slim

# Install a static ffmpeg/ffprobe with h264_nvenc (BtbN gpl build). Pinned to the
# n7.1 line on purpose: the `master` build targets nvenc SDK 13.1 (needs a newer
# driver), whereas the Unraid host runs driver 580, so master's h264_nvenc fails
# at runtime. n7.1 targets an older SDK that 580 supports (verified on
# fraggell-review, vault C182). The build step asserts h264_nvenc is compiled in.
# If no GPU is present at runtime the worker auto-falls back to libx264 (see
# generateProxy nvencAvailable()).
# We mirror the binaries because BtbN publishes a single ROLLING `latest`
# release rather than pinned artifacts. On 2026-08-17 they rotated it and
# dropped the n7.1 line, so the URL this used to curl became a hard 404 and
# this image could no longer be built at all. ghcr.io/fraggell-tools/ffmpeg-nvenc
# holds the exact binaries already running in prod
# (n7.1.5-16-g9a4bb2c579-20260816). Always reference the dated tag, never a
# moving one, since a moving tag is precisely what broke.
RUN apt-get update \
  && apt-get install -y --no-install-recommends procps \
  && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/fraggell-tools/ffmpeg-nvenc:n7.1.5-20260816 /ffmpeg /ffprobe /usr/local/bin/
RUN chmod +x /usr/local/bin/ffmpeg /usr/local/bin/ffprobe \
  && ffmpeg -hide_banner -encoders | grep -q h264_nvenc

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --omit=dev

# Copy worker files
COPY worker ./worker

# Copy shared lib files the worker depends on
COPY src/lib ./src/lib

# Copy TypeScript configs
COPY tsconfig.json ./

# Install tsx for running TypeScript directly
RUN npm install -g tsx

CMD ["tsx", "worker/index.ts"]
